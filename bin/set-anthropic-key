#!/usr/bin/env bash
# Stores CUBBY_ANTHROPIC_API_KEY as a SecureString for the demo host and switches the running host's AI to
# the Anthropic API, restarts the app, then indexes the handbook and drafts the open queue. Prints nothing secret. Safe to re-run.
#   CUBBY_ANTHROPIC_API_KEY=... bin/set-anthropic-key      (or have it exported from ~/.secrets)
set -euo pipefail
cd "$(dirname "$0")/.."
export AWS_PROFILE=cubby AWS_REGION=us-east-1
[ "$(aws sts get-caller-identity --query Account --output text)" = "731956852586" ] || { echo "Refusing: not the cubby account" >&2; exit 1; }
[ -n "${CUBBY_ANTHROPIC_API_KEY:-}" ] || { echo "Set CUBBY_ANTHROPIC_API_KEY first (source ~/.secrets)" >&2; exit 1; }

aws ssm put-parameter --name /cubby/demo/ANTHROPIC_API_KEY --type SecureString --overwrite \
  --value "$CUBBY_ANTHROPIC_API_KEY" > /dev/null
echo "Stored /cubby/demo/ANTHROPIC_API_KEY"

# The host reads the key from Parameter Store itself, so the value never passes through the command.
instance=$(terraform -chdir=infra/terraform/demo output -raw instance_id)
script='set -e
cd /opt/cubby
key=$(aws ssm get-parameters-by-path --region us-east-1 --path /cubby/demo --with-decryption \
  --query "Parameters[?Name==\`/cubby/demo/ANTHROPIC_API_KEY\`].Value | [0]" --output text)
[ -n "$key" ] && [ "$key" != None ] || { echo "key not readable on host" >&2; exit 1; }
umask 077
grep -v -e "^AI_PROVIDER=" -e "^ANTHROPIC_API_KEY=" app.env > app.env.tmp || true
printf "AI_PROVIDER=anthropic\nANTHROPIC_API_KEY=%s\n" "$key" >> app.env.tmp
mv app.env.tmp app.env
docker compose up -d --force-recreate --no-deps api sidekiq events
sleep 20
# Handbook chunks for full-text search, drafts for the open queue, and the labelled analytics history.
docker compose exec -T api bin/rails cubby:policies:index cubby:draft
docker compose exec -T api bin/rails runner "load \"db/seeds/history.rb\""
echo restarted'
id=$(aws ssm send-command --instance-ids "$instance" --document-name AWS-RunShellScript \
  --parameters "$(jq -n --arg s "$script" '{commands: [$s]}')" --query Command.CommandId --output text)
# Indexing and drafting the queue can outlast the CLI's built-in waiter, so poll for up to ten minutes.
for _ in $(seq 1 120); do
  status=$(aws ssm get-command-invocation --command-id "$id" --instance-id "$instance" --query Status --output text 2>/dev/null || echo Pending)
  case "$status" in Pending|InProgress|Delayed) sleep 5 ;; *) break ;; esac
done
aws ssm get-command-invocation --command-id "$id" --instance-id "$instance" \
  --query '[StandardOutputContent,StandardErrorContent]' --output text | tail -15
echo "Host command: $status"
[ "$status" = Success ]
